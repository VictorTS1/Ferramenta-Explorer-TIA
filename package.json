{
  "name": "ferramenta-explorer-tia",
  "version": "0.1.0",
  "private": true,
  "description": "Pesquisa local de blocos exportados do TIA Portal.",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:watch:main\" \"npm:watch:preload\" \"npm:electron\"",
    "watch:main": "tsc -p tsconfig.main.json --watch",
    "watch:preload": "tsc -p tsconfig.preload.json --watch",
    "electron": "wait-on tcp:5173 file:dist/main/index.js file:dist/preload/index.js && electron .",
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && vite build",
    "test": "vitest run --root ."
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "5.4.14"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "concurrently": "9.1.2",
    "electron": "32.3.3",
    "typescript": "5.7.2",
    "vitest": "2.1.8",
    "wait-on": "8.0.1"
  }
}
